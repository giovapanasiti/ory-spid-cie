# =============================================================================
# IAM platform — environment template (LOCAL DEVELOPMENT).
# `make setup` copies this file to `.env` and replaces every __GENERATE_*__
# placeholder with a freshly generated random value. Never commit `.env`.
# Production secrets must come from a secrets manager (see docs/deployment).
# =============================================================================

# --- PostgreSQL (one database + role per service) ----------------------------
POSTGRES_PASSWORD=__GENERATE_PASSWORD__          # superuser, used only for init
KRATOS_DB_PASSWORD=__GENERATE_PASSWORD__         # role "kratos", db "kratos"
HYDRA_DB_PASSWORD=__GENERATE_PASSWORD__          # role "hydra", db "hydra"
BROKER_DB_PASSWORD=__GENERATE_PASSWORD__         # role "broker", db "federation"
IDENTITY_DB_PASSWORD=__GENERATE_PASSWORD__       # role "identity", db "identity"
AUDIT_DB_PASSWORD=__GENERATE_PASSWORD__          # role "audit", db "audit"

# --- Ory Kratos ---------------------------------------------------------------
KRATOS_SECRETS_COOKIE=__GENERATE_HEX32__         # session/CSRF cookie signing (rotate: prepend new)
KRATOS_SECRETS_CIPHER=__GENERATE_HEX16__         # exactly 32 chars, encrypts OIDC tokens at rest

# --- Ory Hydra ----------------------------------------------------------------
HYDRA_SECRETS_SYSTEM=__GENERATE_HEX32__          # encrypts data at rest, signs cookies
HYDRA_SECRETS_COOKIE=__GENERATE_HEX32__

# --- Federation broker (SPID/CIE) --------------------------------------------
BROKER_SEAL_KEYS=__GENERATE_SEALKEY__            # kid:base64(32 bytes); encrypts private keys & PII at rest
BROKER_ADMIN_TOKEN=__GENERATE_HEX32__            # admin-console -> broker admin API
BROKER_INTERNAL_TOKEN=__GENERATE_HEX32__         # identity-service -> broker internal API
BROKER_FACADE_CLIENT_SECRET=__GENERATE_HEX32__   # Kratos -> broker OIDC facade client secret

# --- identity-service ---------------------------------------------------------
IDENTITY_SERVICE_TOKEN=__GENERATE_HEX32__        # callers -> identity-service internal API
IDENTITY_FIELD_SEAL_KEYS=__GENERATE_SEALKEY__    # encrypts verified attributes at rest
IDENTITY_LOOKUP_HMAC_KEY=__GENERATE_HEX32__      # HMAC for exact-match attribute search

# --- audit-service ------------------------------------------------------------
AUDIT_INGEST_TOKEN=__GENERATE_HEX32__            # services -> POST /events
AUDIT_READ_TOKEN=__GENERATE_HEX32__              # admin-console -> GET /events
AUDIT_RETENTION_DAYS=365

# --- login-consent ------------------------------------------------------------
LOGIN_COOKIE_SEAL_KEYS=__GENERATE_SEALKEY__
LOGIN_CSRF_SECRET=__GENERATE_HEX32__

# --- admin-console ------------------------------------------------------------
ADMIN_OIDC_CLIENT_SECRET=__GENERATE_HEX32__      # Hydra client "admin-console"
ADMIN_COOKIE_SEAL_KEYS=__GENERATE_SEALKEY__
ADMIN_CSRF_SECRET=__GENERATE_HEX32__
ADMIN_BOOTSTRAP_EMAILS=admin@iam.local           # first verified login with this email becomes superadmin if none exists
ADMIN_REQUIRED_LOA=                              # e.g. urn:iam:loa:substantial in production

# --- identity-portal ----------------------------------------------------------
PORTAL_CSRF_SECRET=__GENERATE_HEX32__

# --- demo application ---------------------------------------------------------
DEMO_OIDC_CLIENT_SECRET=__GENERATE_HEX32__       # Hydra client "demo-web"
DEMO_M2M_CLIENT_SECRET=__GENERATE_HEX32__        # Hydra client "demo-m2m" (client_credentials)
DEMO_CSRF_SECRET=__GENERATE_HEX32__

# --- development seed (local only) -------------------------------------------
DEV_ADMIN_EMAIL=admin@iam.local
DEV_ADMIN_PASSWORD=__GENERATE_PASSWORD__         # printed by `make seed`
