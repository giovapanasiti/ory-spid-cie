{
  "name": "iam-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.3.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/identity-service",
    "services/audit-service",
    "services/demo-api",
    "tests/e2e"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json --noEmit false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test --test-reporter=spec \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\" \"services/*/src/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\" \"services/*/src/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
